#: src/Lib/AdminSections/LoginSettings.php:42
msgid "An IP is blocked after this many failed logins within the counting window."
msgstr "Une IP est bloquée après ce nombre de connexions échouées sur la période de comptage."

#: src/Lib/AdminSections/LoginSettings.php:47
msgid "Forget IPs after"
msgstr "Oublier les IP après"

#: src/Lib/AdminSections/LoginSettings.php:49
msgid " day(s)"
msgstr " jour(s)"

#: src/Lib/AdminSections/LoginSettings.php:49
msgid "Removes IP records that were inactive for this many days. 0 keeps them."
msgstr "Supprime les enregistrements d’IP inactifs depuis ce nombre de jours. 0 les conserve."

#: src/Lib/AdminSections/LoginSettings.php:54
msgid "Forget only IPs with fewer than"
msgstr "N’oublier que les IP avec moins de"

#: src/Lib/AdminSections/LoginSettings.php:56
msgid " failed logins"
msgstr " connexions échouées"

#: src/Lib/AdminSections/LoginSettings.php:56
msgid "IPs with this many failed logins or more are kept."
msgstr "Les IP ayant ce nombre de connexions échouées ou plus sont conservées."

#: src/Lib/AdminSections/LoginSettings.php:61
msgid "Login page address"
msgstr "Adresse de la page de connexion"

#: src/Lib/AdminSections/LoginSettings.php:62
