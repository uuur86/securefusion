msgstr "(adresse du site)"

#: src/Lib/AdminSections/LoginSettings.php:63
msgid "Example: hidden-login. Leave it empty to keep the standard wp-login.php address."
msgstr "Exemple : connexion-cachee. Laissez vide pour conserver l’adresse standard wp-login.php."

#: src/Lib/AdminSections/LoginSettings.php:68
msgid "Login error message"
msgstr "Message d’erreur de connexion"

#: src/Lib/AdminSections/LoginSettings.php:69
msgid "Shown instead of the WordPress message, which tells attackers whether a username exists. Leave it empty to keep the WordPress message."
msgstr "Affiché à la place du message de WordPress, qui indique aux attaquants si un identifiant existe. Laissez vide pour conserver le message de WordPress."

