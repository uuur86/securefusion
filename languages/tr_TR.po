#: src/Lib/AdminSections/LoginSettings.php:19 src/Lib/AdminSettingsView.php:66
msgid "Login"
msgstr "Giriş"

#: src/Lib/AdminSections/LoginSettings.php:20
msgid "Limits password guessing and can move the login page to an address only you know. Write down a new login address before you save it."
msgstr "Parola tahminini sınırlar ve giriş sayfasını yalnızca sizin bildiğiniz bir adrese taşıyabilir. Yeni giriş adresini kaydetmeden önce bir yere not edin."

#: src/Lib/AdminSections/LoginSettings.php:26
msgid "Lockout duration"
msgstr "Engel süresi"

#: src/Lib/AdminSections/LoginSettings.php:28
msgid " hour(s)"
msgstr " saat"

#: src/Lib/AdminSections/LoginSettings.php:28
msgid "How long an IP stays blocked after too many failed logins."
msgstr "Çok fazla başarısız girişten sonra bir IP’nin ne kadar süre engelli kalacağı."

#: src/Lib/AdminSections/LoginSettings.php:33
msgid "Counting window"
msgstr "Sayım aralığı"

#: src/Lib/AdminSections/LoginSettings.php:35
msgid "Failed logins are counted within this period."
msgstr "Başarısız girişler bu süre içinde sayılır."

#: src/Lib/AdminSections/LoginSettings.php:40
msgid "Failed logins allowed"
msgstr "İzin verilen başarısız giriş sayısı"

#: src/Lib/AdminSections/LoginSettings.php:42
msgid " attempts"
msgstr " deneme"

#: src/Lib/AdminSections/LoginSettings.php:42
msgid "An IP is blocked after this many failed logins within the counting window."
msgstr "Bir IP, sayım aralığında bu sayıda başarısız girişten sonra engellenir."

#: src/Lib/AdminSections/LoginSettings.php:47
msgid "Forget IPs after"
msgstr "IP’leri şu süreden sonra unut"

#: src/Lib/AdminSections/LoginSettings.php:49
msgid " day(s)"
msgstr " gün"

#: src/Lib/AdminSections/LoginSettings.php:49
msgid "Removes IP records that were inactive for this many days. 0 keeps them."
msgstr "Bu kadar gün etkinlik göstermeyen IP kayıtlarını siler. 0 kayıtları saklar."

#: src/Lib/AdminSections/LoginSettings.php:54
msgid "Forget only IPs with fewer than"
msgstr "Yalnızca şundan az başarısız girişi olan IP’leri unut:"

#: src/Lib/AdminSections/LoginSettings.php:56
msgid " failed logins"
msgstr " başarısız giriş"

#: src/Lib/AdminSections/LoginSettings.php:56
msgid "IPs with this many failed logins or more are kept."
msgstr "Bu sayıda veya daha fazla başarısız girişi olan IP’ler saklanır."

#: src/Lib/AdminSections/LoginSettings.php:61
msgid "Login page address"
msgstr "Giriş sayfası adresi"

#: src/Lib/AdminSections/LoginSettings.php:62
msgid "(site address)"
msgstr "(site adresi)"

#: src/Lib/AdminSections/LoginSettings.php:63
msgid "Example: hidden-login. Leave it empty to keep the standard wp-login.php address."
msgstr "Örnek: gizli-giris. Standart wp-login.php adresini korumak için boş bırakın."

#: src/Lib/AdminSections/LoginSettings.php:68
msgid "Login error message"
msgstr "Giriş hata mesajı"

#: src/Lib/AdminSections/LoginSettings.php:69
msgid "Shown instead of the WordPress message, which tells attackers whether a username exists. Leave it empty to keep the WordPress message."
msgstr "Saldırganlara bir kullanıcı adının var olup olmadığını söyleyen WordPress mesajı yerine gösterilir. WordPress mesajını korumak için boş bırakın."

