#: src/Lib/AdminSections/ActiveGuardSettings.php:19 src/Lib/AdminSettingsView.php:68
msgid "Firewall"
msgstr "Cortafuegos"

#: src/Lib/AdminSections/ActiveGuardSettings.php:20
msgid "Checks requests before WordPress handles them and hides details that attackers look for. The request filter is in beta."
msgstr "Comprueba las peticiones antes de que WordPress las procese y oculta los detalles que buscan los atacantes. El filtro de peticiones está en beta."

#: src/Lib/AdminSections/ActiveGuardSettings.php:28
msgid "Blocks requests that contain common attack patterns such as code injection and cross-site scripting. The patterns are on the Advanced tab."
msgstr "Bloquea las peticiones que contienen patrones de ataque habituales, como la inyección de código y el cross-site scripting. Los patrones están en la pestaña Avanzado."

#: src/Lib/AdminSections/ActiveGuardSettings.php:32 src/Lib/AdminSections/ActiveGuardSettings.php:49 src/Lib/AdminSections/ActiveGuardSettings.php:66 src/Lib/AdminSections/ActiveGuardSettings.php:83 src/Lib/AdminSections/ActiveGuardSettings.php:100 src/Lib/AdminSections/ActiveGuardSettings.php:117 src/Lib/AdminSections/ActiveGuardSettings.php:134 src/Lib/AdminSections/ActiveGuardSettings.php:158 src/Lib/AdminSections/RecaptchaSettings.php:80 src/Lib/AdminSections/RecaptchaSettings.php:96 src/Lib/AdminSections/RecaptchaSettings.php:112 src/Lib/AdminSections/RecaptchaSettings.php:128 src/Lib/AdminSections/RecaptchaSettings.php:144 src/Lib/AdminSections/RecaptchaSettings.php:160 src/Lib/AdminSections/XmlrpcSettings.php:31 src/Lib/AdminSections/XmlrpcSettings.php:48 src/Lib/AdminSections/XmlrpcSettings.php:65 src/Lib/AdminSections/XmlrpcSettings.php:82 src/Lib/AdminSettingsView.php:272
msgid "No"
msgstr "No"

#: src/Lib/AdminSections/ActiveGuardSettings.php:36 src/Lib/AdminSections/ActiveGuardSettings.php:53 src/Lib/AdminSections/ActiveGuardSettings.php:70 src/Lib/AdminSections/ActiveGuardSettings.php:87 src/Lib/AdminSections/ActiveGuardSettings.php:104 src/Lib/AdminSections/ActiveGuardSettings.php:121 src/Lib/AdminSections/ActiveGuardSettings.php:138 src/Lib/AdminSections/ActiveGuardSettings.php:162 src/Lib/AdminSections/RecaptchaSettings.php:84 src/Lib/AdminSections/RecaptchaSettings.php:100 src/Lib/AdminSections/RecaptchaSettings.php:116 src/Lib/AdminSections/RecaptchaSettings.php:132 src/Lib/AdminSections/RecaptchaSettings.php:148 src/Lib/AdminSections/RecaptchaSettings.php:164 src/Lib/AdminSections/XmlrpcSettings.php:35 src/Lib/AdminSections/XmlrpcSettings.php:52 src/Lib/AdminSections/XmlrpcSettings.php:69 src/Lib/AdminSections/XmlrpcSettings.php:86 src/Lib/AdminSettingsView.php:276
msgid "Yes"
msgstr "Sí"

#: src/Lib/AdminSections/ActiveGuardSettings.php:44
msgid "Close the REST API to visitors"
msgstr "Cerrar la API REST a los visitantes"

#: src/Lib/AdminSections/ActiveGuardSettings.php:45
msgid "Visitors who are not logged in cannot read posts, pages, users or settings through /wp-json/wp/v2/. The API index and the endpoints of other plugins stay open."
msgstr "Los visitantes que no han accedido no pueden leer entradas, páginas, usuarios ni ajustes a través de /wp-json/wp/v2/. El índice de la API y los endpoints de otros plugins siguen abiertos."

#: src/Lib/AdminSections/ActiveGuardSettings.php:61
msgid "Hide usernames from visitors"
msgstr "Ocultar los nombres de usuario a los visitantes"

#: src/Lib/AdminSections/ActiveGuardSettings.php:62
msgid "Stops the common ways to find login names: ?author=1 links, the REST users list, administrators in the users sitemap and oEmbed author data. Author pages keep working."
msgstr "Bloquea las formas habituales de averiguar nombres de acceso: enlaces ?author=1, la lista de usuarios de REST, los administradores en el mapa del sitio de usuarios y los datos de autor de oEmbed. Las páginas de autor siguen funcionando."

#: src/Lib/AdminSections/ActiveGuardSettings.php:78
msgid "Hide server and PHP versions"
msgstr "Ocultar las versiones del servidor y de PHP"

#: src/Lib/AdminSections/ActiveGuardSettings.php:79
msgid "Removes the Server and X-Powered-By response headers that reveal software versions."
msgstr "Elimina las cabeceras de respuesta Server y X-Powered-By, que revelan versiones de software."

#: src/Lib/AdminSections/ActiveGuardSettings.php:95
msgid "Block bad bots"
msgstr "Bloquear bots maliciosos"

#: src/Lib/AdminSections/ActiveGuardSettings.php:96
msgid "Blocks requests whose user agent matches the bad bot list (by default libwww-perl)."
msgstr "Bloquea las peticiones cuyo agente de usuario coincide con la lista de bots maliciosos (por defecto libwww-perl)."

#: src/Lib/AdminSections/ActiveGuardSettings.php:112
msgid "Send browser security headers"
msgstr "Enviar cabeceras de seguridad del navegador"

#: src/Lib/AdminSections/ActiveGuardSettings.php:113
msgid "Sends X-Frame-Options, X-Content-Type-Options and Referrer-Policy. Content Security Policy and HSTS have their own settings."
msgstr "Envía X-Frame-Options, X-Content-Type-Options y Referrer-Policy. La política de seguridad de contenido y HSTS tienen sus propios ajustes."

#: src/Lib/AdminSections/ActiveGuardSettings.php:129
msgid "Isolate pages from other windows (COOP)"
msgstr "Aislar las páginas de otras ventanas (COOP)"

#: src/Lib/AdminSections/ActiveGuardSettings.php:130
msgid "Sends Cross-Origin-Opener-Policy: same-origin. This blocks some cross-site leaks but breaks sign-in pop-ups such as \"Sign in with Google\". Leave it off if you use them."
msgstr "Envía Cross-Origin-Opener-Policy: same-origin. Esto bloquea algunas fugas entre sitios, pero rompe las ventanas emergentes de acceso como «Iniciar sesión con Google». Déjelo desactivado si las usa."

#: src/Lib/AdminSections/ActiveGuardSettings.php:145
msgid "Maximum request size"
msgstr "Tamaño máximo de petición"

#: src/Lib/AdminSections/ActiveGuardSettings.php:147
msgid " bytes"
msgstr " bytes"

#: src/Lib/AdminSections/ActiveGuardSettings.php:147
msgid "Larger requests from visitors (file uploads excluded) are written to the Security Log. 0 turns the check off. Default: 4096."
msgstr "Las peticiones más grandes de los visitantes (salvo las subidas de archivos) se anotan en el registro de seguridad. 0 desactiva la comprobación. Por defecto: 4096."

#: src/Lib/AdminSections/ActiveGuardSettings.php:153
msgid "Block oversized requests"
msgstr "Bloquear peticiones demasiado grandes"

#: src/Lib/AdminSections/ActiveGuardSettings.php:154
msgid "Check the Security Log first."
msgstr "Revise antes el registro de seguridad."

#: src/Lib/AdminSections/ActiveGuardSettings.php:154
msgid "Long comments and checkout forms can go over the limit. A blocked address cannot open any page of this site until the block ends."
msgstr "Los comentarios largos y los formularios de pago pueden superar el límite. Una dirección bloqueada no puede abrir ninguna página de este sitio hasta que termine el bloqueo."

#: src/Lib/AdminSections/ActiveGuardSettings.php:169
msgid "Oversized requests allowed"
msgstr "Peticiones demasiado grandes permitidas"

#: src/Lib/AdminSections/ActiveGuardSettings.php:171
msgid " requests"
msgstr " peticiones"

#: src/Lib/AdminSections/ActiveGuardSettings.php:171
msgid "An address is blocked when it reaches this many oversized requests within 10 minutes. A single request never blocks anyone unless this is 1. Default: 5."
msgstr "Una dirección se bloquea cuando alcanza este número de peticiones demasiado grandes en 10 minutos. Una sola petición nunca bloquea a nadie, salvo que el valor sea 1. Por defecto: 5."

#: src/Lib/AdminSections/ActiveGuardSettings.php:176
msgid "Oversized request block time"
