#: src/Lib/AdminDashboard.php:257
msgid "XML-RPC FULL PROTECTION"
msgstr "XML-RPC VOLLSTÄNDIGER SCHUTZ"

#: src/Lib/AdminDashboard.php:259
msgid "Blocks all remote requests. Most commonly used to prevent all types of remote attacks."
msgstr "Blockiert alle Remote-Anfragen. Wird am häufigsten verwendet, um alle Arten von Remote-Angriffen zu verhindern."

#: src/Lib/AdminDashboard.php:263
msgid "XML-RPC LOGIN PROTECTION"
msgstr "XML-RPC ANMELDESCHUTZ"

#: src/Lib/AdminDashboard.php:265
msgid "Blocks remote login requests. Most commonly used to prevent brute force login attempts."
msgstr "Blockiert Remote-Anmeldeanfragen. Wird am häufigsten verwendet, um Brute-Force-Anmeldeversuche zu verhindern."

#: src/Lib/AdminDashboard.php:269
msgid "XML-RPC PINGBACK PROTECTION"
msgstr "XML-RPC PINGBACK-SCHUTZ"

#: src/Lib/AdminDashboard.php:271
msgid "Blocks remote pingback requests. Most commonly used to prevent DDoS attacks."
msgstr "Blockiert Remote-Pingback-Anfragen. Wird meist verwendet, um DDoS-Angriffe zu verhindern."

#: src/Lib/AdminDashboard.php:275
msgid "SELF PINGBACK PROTECTION"
msgstr "SCHUTZ DER EIGENEN PINGBACKS"

#: src/Lib/AdminDashboard.php:277
msgid "Blocks remote self-pingback requests. Most commonly used to prevent DDoS attacks."
msgstr "Blockiert Self-Pingback-Anfragen. Wird meist verwendet, um DDoS-Angriffe zu verhindern."

#: src/Lib/AdminDashboard.php:281
msgid "New Custom Login URL"
msgstr "Neue benutzerdefinierte Anmelde-URL"

#: src/Lib/AdminDashboard.php:283
msgid "Hides login url from the attackers."
msgstr "Verbirgt die Anmelde-URL vor Angreifern."

#: src/Lib/AdminDashboard.php:287
msgid "Enable HTTPS / SSL"
msgstr "HTTPS / SSL aktivieren"

#: src/Lib/AdminDashboard.php:289
